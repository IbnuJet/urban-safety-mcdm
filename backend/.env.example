# Application
APP_NAME="DSS Prioritas Perbaikan PJU & Mitigasi Kriminalitas Dini Hari Jatinangor"
APP_VERSION="1.0.0"
API_V1_PREFIX="/api/v1"
DEBUG=false

# Database (Supabase PostgreSQL Session Pooler)
DATABASE_URL="postgresql+psycopg://postgres.[PROJECT-REF]:[PASSWORD]@aws-1-ap-northeast-1.pooler.supabase.com:5432/postgres?sslmode=require"

# Security & JWT
JWT_SECRET_KEY="ganti-dengan-secret-key-minimal-32-karakter-yang-aman"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Business Rules
INSPECTION_EXPIRY_DAYS=90

# CORS
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
